# Copy this file to ".env" and fill in real values.
# .env is ignored by Git - NEVER commit real secrets.
# In production, set the same names in Hostinger > Environment variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flyskymods

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Shown to customers at checkout (manual UPI payment)
PAYMENT_UPI_ID=yourname@upi
PAYMENT_NAME=FlySkyMods

# Cloudflare R2 (mod file uploads/downloads)
# Cloudflare > R2 > Manage API tokens > Object Read & Write, this bucket only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flyskymods-downloads
