# Copy this file to ".env" and fill in real values.
# .env is ignored by Git - NEVER commit real secrets.
# In production, set the same names in Hostinger > Environment variables.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flyskymods

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string
